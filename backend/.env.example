# Flask Configuration
FLASK_ENV=development
SECRET_KEY=mygarage-secret-key-change-in-production
PORT=5000

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=mygarage_db

# File Upload Configuration (5MB = 5 * 1024 * 1024 bytes)
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
